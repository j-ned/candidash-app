{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candidash-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // pg (TCP vers Hyperdrive) et quelques modules Node (crypto) en ont besoin
  "compatibility_flags": ["nodejs_compat"],
  // Même adresse que l'API Nest : l'extension et le front n'ont rien à changer
  "routes": [{ "pattern": "api-candidash.nedellec-julien.fr", "custom_domain": true }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `wrangler hyperdrive create candidash-db --connection-string=…` (via le Cloudflare Tunnel)
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://candidash:candidash@localhost:5432/candidash"
    }
  ],
  // Limites par IP et par chemin (le throttler Nest) ; période 10 s ou 60 s seulement
  "ratelimits": [
    { "name": "STRICT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "candidash-app" }],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://candidash.nedellec-julien.fr",
    // SMTP : MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASSWORD, MAIL_FROM_ADDRESS en secrets
    // (`wrangler secret put`), mêmes valeurs que le .env de l'API Nest
    "MAIL_FROM_NAME": "Candidash"
  },
  // Relances toutes les heures ; purges à 2 h UTC (3 h ou 4 h à Paris)
  "triggers": { "crons": ["0 * * * *", "0 2 * * *"] },
  "observability": { "enabled": true }
}
