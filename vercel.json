{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "api": {
      "root": "apps/api/",
      "framework": "hono",
      "installCommand": "pnpm install --frozen-lockfile --filter api",
      "buildCommand": "pnpm build",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . \":(exclude,glob)**/*.md\" \":(exclude)docs\" \":(exclude)apps/web/docs\" \":(exclude).github\"",
      "entrypoint": "server.js"
    },
    "web": {
      "root": "apps/web/",
      "framework": "angular",
      "installCommand": "pnpm install --frozen-lockfile --filter web",
      "buildCommand": "pnpm build",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . \":(exclude,glob)**/*.md\" \":(exclude)docs\" \":(exclude)apps/web/docs\" \":(exclude).github\"",
      "outputDirectory": "dist/ng-candidash-app/browser",
      "routes": [
        {
          "src": "^/(.*)$",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src blob:; connect-src 'self' https://api-candidash.nedellec-julien.fr; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "DENY",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
          },
          "continue": true
        },
        {
          "src": "^/(?:main|chunk|styles|polyfills|worker)-[A-Za-z0-9_-]{8}\\.(?:js|css)$",
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "src": "^/(?:icons|demo|badges)/(.*)$",
          "has": [
            {
              "type": "query",
              "key": "v"
            }
          ],
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "src": "^/fonts/(.*)$",
          "headers": {
            "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
          },
          "continue": true
        },
        {
          "src": "^/config\\.json$",
          "headers": {
            "Cache-Control": "no-cache"
          },
          "continue": true
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "^/((?!.*\\.[a-zA-Z0-9]+$).*)$",
          "dest": "/index.csr.html",
          "check": true
        },
        {
          "src": "^/(.*)$",
          "status": 404,
          "headers": {
            "Cache-Control": "no-cache"
          }
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "0 7 * * *"
    }
  ]
}
