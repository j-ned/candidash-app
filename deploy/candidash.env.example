# Variables de production de la pile `deploy/compose.yaml`. Modèle sans secret : coller le contenu
# rempli dans l'onglet Environment du service Compose de Dokploy, qui l'écrit dans le `.env` voisin
# du compose. Le fichier rempli ne se versionne jamais et ne se colle ni dans une issue ni dans un
# journal de CI. Une variable facultative se laisse commentée.

# --- Postgres -------------------------------------------------------------------------------------
POSTGRES_USER=candidash
POSTGRES_DB=candidash
# openssl rand -hex 32 (hexadécimal : la valeur entre telle quelle dans l'URL de connexion)
POSTGRES_PASSWORD=

# --- Front ------------------------------------------------------------------------------------------
# Identifiant de l'extension Chrome et fiche de l'extension Firefox (publics, facultatifs), écrits
# dans le config.json du front au démarrage du conteneur.
EXTENSION_ID=
FIREFOX_ADDON_URL=

# --- API --------------------------------------------------------------------------------------------
# Origine du front (CORS). Le front appelle l'API sur sa propre origine, sous /api/v1.
ALLOWED_ORIGINS=https://candidash.nedellec-julien.fr
# À reprendre à l'identique de l'hébergement précédent : changer JWT_SECRET déconnecte toutes les
# sessions et invalide les jetons de l'extension ; changer TOTP_ENCRYPTION_KEY rend la 2FA illisible.
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# openssl rand -hex 32 ; envoyé chaque jour par le service `candidash-cron` à /api/v1/cron/daily
CRON_SECRET=
# En-tête qui porte l'adresse du visiteur. Par défaut cf-connecting-ip (tunnel Cloudflare).
# CLIENT_IP_HEADER=

# Stockage des fichiers (Cloudflare R2) : Access Key ID et Secret Access Key d'un même jeton R2
S3_ENDPOINT=
# S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Mail (Resend) : MAIL_FROM est une adresse seule, sur un domaine vérifié
RESEND_API_KEY=
MAIL_FROM=
# MAIL_FROM_NAME=Candidash
# Destinataire du formulaire de contact (absent : le formulaire répond 503)
# CONTACT_RECIPIENT=

# --- Sauvegardes de la base -------------------------------------------------------------------------
# Bucket R2 privé, distinct de celui des fichiers, avec un jeton d'API limité à ce bucket.
# https://<identifiant de compte>.r2.cloudflarestorage.com, sans `/` final
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# openssl rand -base64 48 ; à conserver aussi hors du serveur (gestionnaire de mots de passe) :
# sans elle, aucune sauvegarde ne se déchiffre.
BACKUP_PASSPHRASE=

# --- Retour à une version (facultatif) --------------------------------------------------------------
# WEB_IMAGE=ghcr.io/j-ned/candidash-web:sha-<commit>
# API_IMAGE=ghcr.io/j-ned/candidash-api:sha-<commit>
