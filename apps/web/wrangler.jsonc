{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candidash-front",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-15",
  "routes": [{ "pattern": "candidash.nedellec-julien.fr", "custom_domain": true }],
  "assets": {
    "directory": "./dist/ng-candidash-app/browser",
    "binding": "ASSETS",
    // Chaque requête passe par le Worker : nonce CSP, en-têtes et cache (cloudflare/worker.ts)
    "run_worker_first": true
  },
  "vars": {
    "API_URL": "https://api-candidash.nedellec-julien.fr/api/v1"
    // EXTENSION_ID et FIREFOX_ADDON_URL : mêmes valeurs que les variables Dokploy actuelles
  },
  "observability": { "enabled": true }
}
